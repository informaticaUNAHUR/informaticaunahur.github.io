---
layout: null
permalink: /materias.json
---
{% assign materias_publicadas = site.materias | where_exp: "materia", "materia.published != false" | where_exp: "materia", "materia.excluida_busqueda != true" %}
[
{% for materia in materias_publicadas %}
{% capture carreras_double_output %}{% include materia-carreras.html materia=materia %}{% endcapture %}
{% assign carreras_parts = carreras_double_output | split: "@@@" %}
{% assign carreras_slugs = carreras_parts[0] %}
{% assign carreras_titles = carreras_parts[1] | strip %}
{% assign carreras_titles_array = carreras_titles | split: "|||" %}

{% capture plan_calculado %}
{% include plan-materia.html materia=materia data_carrera=carreras_slugs %}
{% endcapture %}
{% assign plan_calculado = plan_calculado | strip %}

{% capture clean_title %}{% include materia-clean-title.html materia=materia %}{% endcapture %}
{% assign clean_title = clean_title | strip %}

{% assign full_permalink = site.baseurl | append: materia.url %}
  {
    "title": {{ clean_title | jsonify }},
    "slug": {{ materia.slug | jsonify }},
    "permalink": {{ full_permalink | jsonify }},
    "icon": {{ materia.icon | jsonify }},
    "plan": {{ plan_calculado | jsonify }},
    "data_plan": {{ plan_calculado | jsonify }},
    "carreras": {{ carreras_titles_array | jsonify }},
    "data_carrera": {{ carreras_slugs | strip | jsonify }},
    "area_general": {{ materia.area_general | jsonify }},
    "hs_sem": {{ materia.hs_sem | jsonify }},
    "hs_total": {{ materia.hs_total | jsonify }},
    "creditos": {{ materia.creditos | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
